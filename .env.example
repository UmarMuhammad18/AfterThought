# Copy to .env.local and fill in. Everything except Supabase is optional:
# features switch on as their keys are added.

# --- Supabase (required) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment (used in WhatsApp replies to link to notes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Transcription (one of these) --------------------------------------------
# Deepgram: speaker labels, "you / them" separation, mixed-language speech,
# and files of any size. Recommended.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=multi        # or a fixed code like "ar", "hi", "es"
# OpenAI: fallback, 25 MB per file. Also enables semantic search embeddings.
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI analysis (summaries, action items, scorecards, Q&A) -------------------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# --- WhatsApp Cloud API (optional) --------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# The bot's number as people dial it, e.g. 15551234567 (for wa.me links)
WHATSAPP_DISPLAY_NUMBER=
# Approved template with one {{1}} body variable, used outside the 24h window
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_GRAPH_VERSION=v21.0

# --- WhatsApp calling: interviews answered in the browser (optional) ----------
# Who answers calls that don't match a call-interview invite (a Supabase user id)
WHATSAPP_LINE_OWNER_USER_ID=
# Meta also records calls and plays the legally required announcement.
# WHATSAPP_CALL_RECORDING=true
# WHATSAPP_RECORDING_PURPOSE=taking interview notes
# WHATSAPP_RECORDING_LANGUAGE=en_US
# STUN/TURN servers for the browser, as JSON (defaults to Google's public STUN)
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# WHATSAPP_MOCK_ENABLED=false    # allow /api/whatsapp/mock in production

# --- Demo login (dev only; set BOTH to enable) --------------------------------
# DEMO_LOGIN_ENABLED=true
# NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true
