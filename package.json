{
  "name": "afterthought",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:clients": "node scripts/build.js",
    "desktop": "node scripts/build.js && node scripts/run-desktop.js",
    "package:desktop": "node scripts/build.js && electron-builder --config electron-builder.config.js",
    "test:desktop": "node scripts/build.js && node -e \"process.env.AFTERTHOUGHT_SMOKE_TEST=1;require('./scripts/run-desktop.js')\""
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "^0.21.5",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.4"
}
